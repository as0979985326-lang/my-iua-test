local Players = game:GetService("Players")
local player = Players.LocalPlayer

local prices = {}

for _, obj in ipairs(player:WaitForChild("PlayerGui"):GetDescendants()) do
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        local text = obj.Text

        if text and text:match("^%d+%.%d%d$") then
            table.insert(prices, text)
        end
    end
end

-- 去除重複
local unique = {}

for _, price in ipairs(prices) do
    unique[price] = true
end

local list = {}

for price in pairs(unique) do
    table.insert(list, price)
end

table.sort(list)

local result = "找到 " .. #list .. " 個候選價格"

if #list > 0 then
    result = result .. "\n" .. table.concat(list, ", ")
end

game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "RSE2 價格掃描",
    Text = result,
    Duration = 10
})
